{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonheaven/dmp-spec/schemas/list-directed.schema.json",
  "title": "ÐMP 1.0 compact signed order, directed (buyer-bound) mode (compact-orders §17)",
  "type": "object",
  "required": [
    "p",
    "v",
    "op",
    "chain",
    "inscription_id",
    "utxo",
    "price",
    "pay_to",
    "ts",
    "mode",
    "buyer",
    "postage"
  ],
  "properties": {
    "p": {
      "const": "dmp"
    },
    "v": {
      "const": "2"
    },
    "op": {
      "const": "list"
    },
    "mode": {
      "const": "directed"
    },
    "chain": {
      "enum": [
        "dogecoin",
        "dogecoin-testnet",
        "dogecoin-regtest"
      ]
    },
    "inscription_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}i(0|[1-9][0-9]*)$"
    },
    "utxo": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}:(0|[1-9][0-9]*)$"
    },
    "price": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "pay_to": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{26,35}$"
    },
    "pubkey": {
      "type": "string",
      "pattern": "^0[23][0-9a-f]{64}$"
    },
    "redeem_script": {
      "type": "string",
      "pattern": "^(21[0-9a-f]{66}ac|5[1-9a-f](21[0-9a-f]{66}){1,15}5[1-9a-f]ae)$",
      "description": "compact-orders §5.4: P2SH dog, <pk> OP_CHECKSIG or m-of-n OP_CHECKMULTISIG (compressed keys, 1 ≤ m ≤ n ≤ 15)"
    },
    "sig": {
      "type": "string",
      "pattern": "^30[0-9a-f]{12,140}81$"
    },
    "sigs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "string",
        "pattern": "^30[0-9a-f]{12,140}81$"
      },
      "description": "compact-orders §5.4: multisig only, exactly m signatures in redeem_script key order"
    },
    "fees": {
      "type": "object",
      "properties": {
        "royalty_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2}|1[0-9]{3}|2[0-4][0-9]{2}|2500)$"
        },
        "royalty_to": {
          "type": "string"
        },
        "market_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2}|1[0-9]{3}|2000)$"
        },
        "listing_to": {
          "type": "string"
        },
        "listing_share_bps": {
          "type": "string",
          "const": "10000",
          "description": "compact-orders §17.1: directed orders pay the whole market fee to listing_to"
        }
      },
      "dependentRequired": {
        "royalty_bps": [
          "royalty_to"
        ],
        "market_bps": [
          "listing_to",
          "listing_share_bps"
        ]
      }
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "expiry": {
      "type": "integer",
      "minimum": 0
    },
    "psdt": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "asig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{87}=$",
      "description": "compact-orders §7.2: base64(header 31..34 ‖ r ‖ s) over \"dmp-v2-asig:\" ‖ canonical op, Dogecoin signed-message digest"
    },
    "asigs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9+/]{87}=$"
      },
      "description": "compact-orders §7: multisig only, exactly m asig by distinct script keys in key order"
    },
    "buyer": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{26,35}$",
      "description": "compact-orders §17.1: the one buyer address"
    },
    "postage": {
      "type": "string",
      "pattern": "^[1-9][0-9]{5,19}$",
      "description": "compact-orders §17.1: koinu of the pinned dog output, >= 100000"
    }
  },
  "oneOf": [
    {
      "$comment": "P2PKH dog",
      "required": [
        "pubkey",
        "sig"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "redeem_script"
            ]
          },
          {
            "required": [
              "sigs"
            ]
          },
          {
            "required": [
              "asigs"
            ]
          }
        ]
      }
    },
    {
      "$comment": "P2SH <pk> OP_CHECKSIG",
      "required": [
        "redeem_script",
        "sig"
      ],
      "properties": {
        "redeem_script": {
          "pattern": "^21[0-9a-f]{66}ac$"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "pubkey"
            ]
          },
          {
            "required": [
              "sigs"
            ]
          },
          {
            "required": [
              "asigs"
            ]
          }
        ]
      }
    },
    {
      "$comment": "P2SH m-of-n OP_CHECKMULTISIG",
      "required": [
        "redeem_script",
        "sigs",
        "asigs"
      ],
      "properties": {
        "redeem_script": {
          "pattern": "^5[1-9a-f](21[0-9a-f]{66}){1,15}5[1-9a-f]ae$"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "pubkey"
            ]
          },
          {
            "required": [
              "sig"
            ]
          },
          {
            "required": [
              "asig"
            ]
          }
        ]
      }
    }
  ],
  "not": {
    "required": [
      "psdt_hash"
    ]
  },
  "$comment": "Directed orders only (mode \"directed\"). Public orders use list-v2.schema.json. Dust checks (net, royalty and listing outputs >= 100000), the 0x81 signature over the §17.2 outputs and the other §5.4/§6 checks are not expressible here."
}
