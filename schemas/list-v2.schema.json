{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonheaven/dmp-spec/schemas/list-v2.schema.json",
  "title": "ÐMP v2 compact signed order (list)",
  "type": "object",
  "required": ["p", "v", "op", "chain", "inscription_id", "utxo", "price", "pay_to", "ts"],
  "properties": {
    "p": { "const": "dmp" },
    "v": { "const": "2" },
    "op": { "const": "list" },
    "chain": { "enum": ["dogecoin", "dogecoin-testnet", "dogecoin-regtest"] },
    "inscription_id": { "type": "string", "pattern": "^[0-9a-f]{64}i(0|[1-9][0-9]*)$" },
    "utxo": { "type": "string", "pattern": "^[0-9a-f]{64}:(0|[1-9][0-9]*)$" },
    "price": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "pay_to": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{26,35}$" },
    "pubkey": { "type": "string", "pattern": "^0[23][0-9a-f]{64}$" },
    "redeem_script": { "type": "string", "pattern": "^(21[0-9a-f]{66}ac|5[1-9a-f](21[0-9a-f]{66}){1,15}5[1-9a-f]ae)$", "description": "spec-v2 §5.4: P2SH dog, <pk> OP_CHECKSIG or m-of-n OP_CHECKMULTISIG (compressed keys, 1 ≤ m ≤ n ≤ 15)" },
    "sig": { "type": "string", "pattern": "^30[0-9a-f]{12,140}83$" },
    "sigs": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "pattern": "^30[0-9a-f]{12,140}83$" }, "description": "spec-v2 §5.4: multisig only, exactly m signatures in redeem_script key order" },
    "fees": {
      "type": "object",
      "properties": {
        "royalty_bps": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3})$" },
        "royalty_to": { "type": "string" },
        "market_bps": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3})$" },
        "listing_to": { "type": "string" },
        "listing_share_bps": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})$" }
      },
      "dependentRequired": { "royalty_bps": ["royalty_to"] }
    },
    "ts": { "type": "integer", "minimum": 0 },
    "expiry": { "type": "integer", "minimum": 0 },
    "psdt": { "type": "string", "contentEncoding": "base64" },
    "asig": { "type": "string", "pattern": "^[A-Za-z0-9+/]{87}=$", "description": "spec-v2 §7.2: base64(header 31..34 ‖ r ‖ s) over \"dmp-v2-asig:\" ‖ canonical op, Dogecoin signed-message digest" },
    "asigs": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "string", "pattern": "^[A-Za-z0-9+/]{87}=$" }, "description": "spec-v2 §7: multisig only, exactly m asig by distinct script keys in key order" }
  },
  "oneOf": [
    { "$comment": "P2PKH dog", "required": ["pubkey", "sig"], "not": { "anyOf": [{ "required": ["redeem_script"] }, { "required": ["sigs"] }, { "required": ["asigs"] }] } },
    { "$comment": "P2SH <pk> OP_CHECKSIG", "required": ["redeem_script", "sig"], "properties": { "redeem_script": { "pattern": "^21[0-9a-f]{66}ac$" } }, "not": { "anyOf": [{ "required": ["pubkey"] }, { "required": ["sigs"] }, { "required": ["asigs"] }] } },
    { "$comment": "P2SH m-of-n OP_CHECKMULTISIG", "required": ["redeem_script", "sigs", "asigs"], "properties": { "redeem_script": { "pattern": "^5[1-9a-f](21[0-9a-f]{66}){1,15}5[1-9a-f]ae$" } }, "not": { "anyOf": [{ "required": ["pubkey"] }, { "required": ["sig"] }, { "required": ["asig"] }] } }
  ],
  "not": { "required": ["psdt_hash"] },
  "$comment": "Caps (royalty_bps ≤ 2500, market_bps ≤ 2000), net ≥ 100000, signature validity, m ≤ n, the sigs/asigs count = m, key validity and distinctness, and hash160(redeem_script) = the dog's P2SH hash are checked by spec-v2 §5.4/§6, not by this schema."
}
