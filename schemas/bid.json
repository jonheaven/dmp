{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dmp/v1.0/bid",
  "title": "ÐMP bid operation",
  "description": "Expresses purchase intent against a listing or auction target.",
  "type": "object",
  "required": ["p", "v", "op", "price", "bidder"],
  "additionalProperties": true,
  "properties": {
    "p":              { "const": "dmp" },
    "v":              { "const": "1.0" },
    "op":             { "const": "bid" },
    "inscription_id": { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "collection_id":  { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "list_id":        { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "price":          { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "currency":       { "type": "string" },
    "bidder":         { "type": "string", "minLength": 20 },
    "bid_fee":        { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "fee_recipient":  { "type": "string", "minLength": 20 },
    "expiry":         { "type": "integer" },
    "psdt":           { "type": "string" },
    "chain":          { "const": "dogecoin" },
    "nonce":          { "type": "string" },
    "ts":             { "type": "integer" }
  },
  "anyOf": [
    { "required": ["inscription_id"] },
    { "required": ["collection_id"] }
  ],
  "if": {
    "required": ["bid_fee"]
  },
  "then": {
    "required": ["fee_recipient"]
  }
}
