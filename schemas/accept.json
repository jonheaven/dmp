{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dmp/v1.0/accept",
  "title": "ÐMP accept operation",
  "description": "Seller accepts an active offer or counteroffer. Terminal for that negotiation branch.",
  "type": "object",
  "required": ["p", "v", "op", "target_op", "target_id", "seller"],
  "additionalProperties": true,
  "properties": {
    "p":             { "const": "dmp" },
    "v":             { "const": "1.0" },
    "op":            { "const": "accept" },
    "target_op":     { "enum": ["offer", "counteroffer"] },
    "target_id":     { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "seller":        { "type": "string", "minLength": 20 },
    "accept_reason": { "type": "string" },
    "chain":         { "const": "dogecoin" },
    "ts":            { "type": "integer" }
  }
}
