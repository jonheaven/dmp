{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dmp/v1.0/settle",
  "title": "ÐMP settle operation",
  "description": "Records a completed on-chain settlement. Anyone may inscribe. Validity depends entirely on settlement_txid verification.",
  "type": "object",
  "required": ["p", "v", "op", "inscription_id", "seller", "buyer", "price", "settlement_txid"],
  "additionalProperties": true,
  "properties": {
    "p":                      { "const": "dmp" },
    "v":                      { "const": "1.0" },
    "op":                     { "const": "settle" },
    "inscription_id":         { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "list_id":                { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "bid_id":                 { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "auction_id":             { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "seller":                 { "type": "string", "minLength": 20 },
    "buyer":                  { "type": "string", "minLength": 20 },
    "price":                  { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "fees": {
      "type": "object",
      "description": "ÐMP 1.0 fee terms (spec.md §4.3; compact-orders §4.1 floor math). Seller net = price − royalty − market. Over-cap or malformed ⇒ settle invalid (ignored).",
      "properties": {
        "royalty_bps":       { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2}|1[0-9]{3}|2[0-4][0-9]{2}|2500)$" },
        "royalty_to":        { "type": "string", "minLength": 20 },
        "market_bps":        { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2}|1[0-9]{3}|2000)$" },
        "listing_to":        { "type": "string", "minLength": 20 },
        "listing_share_bps": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3}|10000)$" }
      }
    },
    "royalty_paid":           { "type": "string", "pattern": "^[0-9]+$", "description": "Draft claim; checked only when no fees are declared. Never changes seller net." },
    "royalty_address":        { "type": "string", "minLength": 20 },
    "platform_fee":           { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "platform_fee_recipient": { "type": "string", "minLength": 20, "description": "Draft field naming the settlement venue. REQUIRED with platform_fee (MUST-037); an underpaid output is a settlement_fee_ok=false flag, not a status change." },
    "settlement_txid":        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chain":                  { "const": "dogecoin" },
    "ts":                     { "type": "integer" }
  },
  "if": {
    "required": ["platform_fee"]
  },
  "then": {
    "required": ["platform_fee_recipient"]
  }
}
