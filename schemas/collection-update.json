{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dmp/v1.0/collection-update",
  "title": "ÐMP collection-update operation",
  "description": "Append-only patch. supersedes must equal current head. sig verifies to the current signer: the root creator_address until a handover (collection-registry.md §7).",
  "type": "object",
  "required": ["p", "v", "op", "collection_id", "supersedes", "update_of", "patch"],
  "additionalProperties": true,
  "properties": {
    "p":             { "const": "dmp" },
    "v":             { "const": "1.0" },
    "op":            { "const": "collection-update" },
    "collection_id": { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "supersedes":    { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "update_of":     { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
    "patch": {
      "type": "object",
      "not": { "anyOf": [
        { "required": ["slug"] }, { "required": ["chain"] }, { "required": ["type"] },
        { "required": ["parent_inscription_id"] }, { "required": ["creator_address"] }
      ] },
      "properties": {
        "name":            { "type": "string" },
        "description":     { "type": "string", "maxLength": 2000 },
        "image":           { "type": "string", "pattern": "^[0-9a-f]{64}i(0|[1-9][0-9]*)$" },
        "links":           { "type": "object", "additionalProperties": { "type": "string", "maxLength": 512 } },
        "royalty_address": { "type": "string", "minLength": 20 },
        "royalty_bps":     { "type": "string", "pattern": "^([0-9]|[1-9][0-9]{1,2}|1[0-9]{3}|2[0-4][0-9]{2}|2500)$" },
        "retired":         { "const": true },
        "criteria": {
          "type": "object",
          "required": ["members_root", "members_count", "members_chunks"],
          "properties": {
            "members_root":   { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "members_count":  { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" },
            "members_chunks": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
                                "items": { "type": "string", "pattern": "^[0-9a-f]{64}i(0|[1-9][0-9]*)$" } }
          }
        }
      }
    },
    "handover": {
      "type": "object",
      "required": ["to", "sig"],
      "properties": {
        "to":  { "type": "string", "minLength": 20 },
        "sig": { "type": "string" }
      }
    },
    "vote_proof": {
      "type": "object",
      "properties": {
        "vote_inscription_id": { "type": "string", "pattern": "^[0-9a-f]{64}i[0-9]+$" },
        "vote_result":         { "enum": ["approved", "rejected"] },
        "vote_sig":            { "type": "string" }
      },
      "required": ["vote_inscription_id", "vote_result"]
    },
    "sig":     { "type": "string" },
    "sig_msg": { "type": "string" },
    "chain":   { "enum": ["dogecoin", "dogecoin-testnet", "dogecoin-regtest"] },
    "ts":      { "type": "integer" }
  }
}
